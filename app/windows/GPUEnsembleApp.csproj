<Project Sdk="Microsoft.NET.Sdk">
  <!-- GPUEnsemble.exe: the Windows app over the planner (see README.md).
       .NET Framework 4.8 ships with Windows 10 (1903 and later) and 11, so the exe needs no runtime
       of its own. Builds on Windows, Linux or macOS with the .NET SDK: dotnet build -c Release -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GPUEnsemble</AssemblyName>
    <RootNamespace>GPUEnsembleApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>gpuensemble.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Version>0.1.1</Version>
    <Product>GPUEnsemble</Product>
    <Copyright>GPUEnsemble contributors, MIT License</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
